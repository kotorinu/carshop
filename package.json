{
  "name": "kotoiro-car-growth",
  "private": true,
  "version": "0.1.0",
  "description": "外車店(大阪)のTikTok→LINE→来店 集客自動化システム",
  "type": "module",
  "workspaces": [
    "meishi",
    "packages/*"
  ],
  "scripts": {
    "gen:scripts": "tsx packages/script-gen/src/cli.ts",
    "gen:tts": "tsx packages/tts/src/cli.ts",
    "render": "tsx packages/video-pipeline/src/render.ts",
    "preview": "tsx packages/video-pipeline/src/preview-still.ts",
    "doctor": "tsx tools/doctor.ts",
    "make": "tsx tools/make.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "make:video": "node video/make-video.mjs",
    "sync:inventory": "node video/sync-inventory.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
