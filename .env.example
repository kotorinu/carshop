# このファイルを「.env」という名前でコピーして、必要な値だけ埋めてください。
# ★ 最初の1本を作るだけなら、ここは全部空のままでOK（mockで動きます）。

# --- 台本生成・写真選定・自己採点（任意）---
# Claudeの本番台本/AI写真選定/自己採点ループに必要。https://console.anthropic.com で取得
ANTHROPIC_API_KEY=
# 台本のモデル（未設定なら claude-sonnet-4-6）
SCRIPT_GEN_MODEL=
# 写真選定・自己採点のモデル（通常は未設定でOK）
PICK_PHOTOS_MODEL=
SELF_REVIEW_MODEL=

# --- AI動画クリップ生成 Kling（任意・写真が「動く実車」になる）---
# https://klingai.com のAPIコンソールで Access Key / Secret Key を発行
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# --- 音声（任意）---
# VOICEVOXアプリ/エンジンのURL（未設定なら 127.0.0.1:50021）
VOICEVOX_URL=

# --- 動画のエンドカード ---
# プロフィールに置くLINEのURL（エンドカードのQRになる）
LINE_URL=
# 店名・エリア（エンドカード表示）
SHOP_NAME=
SHOP_AREA=

# --- LINE集客bot（Phase3で使用・今は不要）---
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# LIFFフォームを開くURL（メッセージに載る）= https://liff.line.me/<LIFF ID>
LIFF_BOOKING_URL=
LIFF_APPRAISAL_URL=
# LIFF ID だけ（フォームHTMLの liff.init に差し込む）。上のURLの末尾と同じ値
LIFF_BOOKING_ID=
LIFF_APPRAISAL_ID=
# 新着リード(予約/査定)をLINEで受け取るオーナー自身のuserId（未設定ならログ出力のみ）
OWNER_LINE_USER_ID=
PORT=
