{
  "manifest_version": 3,
  "name": "営業応募オートパイロット",
  "version": "1.0.0",
  "description": "実践活動ルール(BtoC・無形商材・アポイント譲渡型)に合う営業代行案件だけを集めて採点し、応募文を自分の言葉で作ってフォームまで自動入力する。送信ボタンだけ自分で押す。",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "clipboardWrite",
    "tabs"
  ],
  "host_permissions": [
    "https://www.lancers.jp/*",
    "https://*.aw-anotherworks.com/*",
    "https://aw-anotherworks.com/*",
    "https://*.anotherworks.co.jp/*",
    "https://jp.indeed.com/*",
    "https://crowdworks.jp/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "営業応募オートパイロット"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.lancers.jp/*",
        "https://*.aw-anotherworks.com/*",
        "https://aw-anotherworks.com/*",
        "https://*.anotherworks.co.jp/*",
        "https://jp.indeed.com/*",
        "https://crowdworks.jp/*"
      ],
      "js": [
        "content/boot.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "core/*.js",
        "content/*.js",
        "content/adapters/*.js",
        "profile.default.json",
        "content/autocollect.js",
        "content/diagnose.js"
      ],
      "matches": [
        "https://*/*"
      ]
    }
  ]
}
