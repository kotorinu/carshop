{
  "manifest_version": 3,
  "name": "営業応募オートパイロット",
  "version": "1.0.0",
  "description": "クラウドソーシングの営業代行案件を集めて、点数を付けて、応募文を自分の言葉で作って、フォームまで自動入力する。送信ボタンだけ自分で押す。",
  "permissions": ["storage", "activeTab", "scripting", "clipboardWrite"],
  "host_permissions": [
    "https://www.lancers.jp/*",
    "https://crowdworks.jp/*",
    "https://coconala.com/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "営業応募オートパイロット" },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.lancers.jp/*",
        "https://crowdworks.jp/*",
        "https://coconala.com/*"
      ],
      "js": ["content/boot.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["core/*.js", "content/*.js", "content/adapters/*.js"],
      "matches": ["https://*/*"]
    }
  ]
}
